# SmartUp Online ERP — Environment Configuration

# 1. Frappe Cloud Backend URL (e.g. https://smartup.m.frappe.cloud or your new online site)
NEXT_PUBLIC_FRAPPE_URL=https://smartup.m.frappe.cloud

# 2. Frappe API Authentication (Server-side only — never exposed to client)
# Generate from Frappe Desk -> User (e.g. Administrator or online-admin) -> API Access
FRAPPE_API_KEY=your_frappe_api_key_here
FRAPPE_API_SECRET=your_frappe_api_secret_here

# 3. Application Metadata
NEXT_PUBLIC_APP_NAME="SmartUp Online ERP"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_DIVISION="SmartUp Online Kerala"

# 4. NextAuth / Session Secret (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=smartup-online-erp-development-secret-key-32chars

# 5. Online Payment Gateway (Optional for local testing)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
